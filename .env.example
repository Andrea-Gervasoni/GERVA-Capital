# Copia in .env (escluso da git). Mai chiavi nei log, nei prompt, nei commit o nel portale.

# Cartella di GERVA-Q v3 (Pod Zero), in sola lettura
GERVA_Q_PATH=~/Documents/GERVA-Q

# Agenti veri. Senza chiave la societa' gira in SIMULAZIONE (risposte finte e prudenti, costo zero).
# Aggiungere una chiave e' una "grande richiesta" (credenziali): la decide Andrea.
# ANTHROPIC_API_KEY=

# Consulenti esterni / Capi Pod ospiti (facoltativi, a pagamento)
# MOONSHOT_API_KEY=
# KIMI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# SEC EDGAR chiede uno User-Agent con un contatto reale (non viene mai scritto nei log)
# SEC_USER_AGENT="GERVA-Capital nome@esempio.it"

# IBKR (solo PAPER). Sul Mac IB Gateway paper ascolta su 4002: e' il conto della SFIDA, usato da GERVA-Q.
# La societa' lo OSSERVA soltanto (sola lettura, clientId 32): NAV e posizioni nel portale e nel Rischio.
# IBKR_OBSERVE=1
# IBKR_GERVAQ_PORT=4002
# IBKR_CHALLENGE_ACCOUNT=DU...        # obbligatorio: serve anche a impedire ai pod di operarci
#
# I pod eseguono su IBKR SOLO con un SECONDO conto paper, su un SECONDO IB Gateway (porta diversa).
# Senza, restano sul broker simulato: e' il default sicuro. Mai la porta 4002 qui.
# IBKR_FIRM_ACCOUNT=DU...             # diverso da IBKR_CHALLENGE_ACCOUNT
# IBKR_FIRM_PORT=4004
# GATEWAY_BROKER=ibkr_paper

# Alpaca PAPER (conto simulato, crypto 24 ore su 24). Chiavi dal pannello Paper di alpaca.markets. SOLO paper: il codice rifiuta altri indirizzi.
# ALPACA_PAPER_KEY=
# ALPACA_PAPER_SECRET=
