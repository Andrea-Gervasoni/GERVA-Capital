# Copia in .env (escluso da git). Mai chiavi nei log, nei prompt, nei commit o nel portale.

# Cartella di GERVA-Q v3 (Pod Zero), in sola lettura
GERVA_Q_PATH=~/Documents/GERVA-Q

# Agenti veri. Senza chiave la societa' gira in SIMULAZIONE (risposte finte e prudenti, costo zero).
# Aggiungere una chiave e' una "grande richiesta" (credenziali): la decide Andrea.
# ANTHROPIC_API_KEY=

# Consulenti esterni / Capi Pod ospiti (facoltativi, a pagamento)
# MOONSHOT_API_KEY=
# KIMI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# SEC EDGAR chiede uno User-Agent con un contatto reale (non viene mai scritto nei log)
# SEC_USER_AGENT="GERVA-Capital nome@esempio.it"

# Gateway verso IB Gateway PAPER (porta 4002). Senza questa riga il Gateway usa il broker paper simulato.
# GATEWAY_BROKER=ibkr_paper
# GATEWAY_IB_PORT=4002
